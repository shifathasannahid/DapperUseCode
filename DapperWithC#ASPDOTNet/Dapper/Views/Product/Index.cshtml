@model IEnumerable<DapperProject.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<h1>@ViewBag.Count</h1>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SupplierID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitsInStock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitsOnOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Discontinued)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiscontinuedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(model => item.SupplierID)
            </td>
            <td>
                @Html.DisplayFor(model => item.CategoryID)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitsInStock)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitsOnOrder)
            </td>
            <td>
                @Html.DisplayFor(model => item.Discontinued)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiscontinuedDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductID">Delete</a> |
                <a asp-action="GetByCategoryId" asp-route-categoryId="@item.CategoryID">Show Product From the category </a>
            </td>
        </tr>
}
    </tbody>
</table>
